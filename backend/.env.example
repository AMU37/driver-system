ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-production-secret
# Supabase Dashboard -> Connect -> Session pooler (recommended for IPv4 environments)
# Keep sslmode=require. Use the exact host/username shown by Supabase.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:3333
COMPANY_CODE_DEFAULT=YCSR
TRIP_RELEASE_HOURS=8
MICROSOFT_ENABLED=false
MICROSOFT_OUTBOUND_URL=
MICROSOFT_INBOUND_API_KEY=replace-with-a-secret-key
MICROSOFT_TIMEOUT_SECONDS=15
